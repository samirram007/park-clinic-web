# ──── Copy this file to .env for local development ────────────
#
#   cp .env.example .env
#
# Then customize any values as needed. For local overrides that
# shouldn't be committed, use .env.local instead.
#
# ──── Company Information ──────────────────────────────────────
VITE_COMPANY_NAME="Park Sonoscan Clinic"
VITE_COMPANY_SHORT_NAME="Park Clinic"
VITE_COMPANY_ADDRESS="4, Gorky Terrace, Minto Park, Kolkata - 700017"
VITE_COMPANY_PHONE="+91 9775992022 / 9775992024"
VITE_COMPANY_PHONE_SHORT="9775992022"
VITE_COMPANY_EMAIL="info@parkclinickolkata.com"

# ──── Site URL (sitemap, OG tags, canonical URLs) ──────────────
VITE_SITE_URL=https://parkclinickolkata.com

# ──── API Configuration ────────────────────────────────────────
# Direct API URL used by the axios client for all requests
VITE_API_URL=http://localhost:8000/api
# Backend origin used by the Vite dev server proxy
VITE_API_BASE_URL=http://localhost:8000
# Whether the backend uses HTTPS (affects Vite proxy config)
VITE_API_SECURE=false
# Auth storage type: 'localStorage' or 'cookie'
VITE_AUTH_STORAGE_TYPE=localStorage

# ──── Vite Config ──────────────────────────────────────────────
VITE_BASE_URL=/

# ──── Contact Chat Widget ───────────────────────────────────────
# Set to 'true' to enable the floating chat widget on guest pages
VITE_CONTACT_CHAT_ENABLED=true

# ──── Search Engine Verification (replace with your actual codes) ─
VITE_GOOGLE_VERIFICATION=YOUR_GOOGLE_VERIFICATION_CODE
VITE_BING_VERIFICATION=YOUR_BING_VERIFICATION_CODE
