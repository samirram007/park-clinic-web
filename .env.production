# ──── Production Overrides ─────────────────────────────────────
# This file overrides values from .env during production builds.
# .env is loaded in all modes, so only put values that differ
# from the development defaults here.
#
# ──── API Configuration ────────────────────────────────────────
VITE_API_BASE_URL=https://api.doc.ctrlaltfix.in
VITE_API_URL=https://api.doc.ctrlaltfix.in/api
VITE_API_SECURE=true
# ──── Contact Chat Widget ───────────────────────────────────────
# Set to 'true' to enable the floating chat widget on guest pages
VITE_CONTACT_CHAT_ENABLED=true
